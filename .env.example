# Copy to .env on the VM (never commit the real .env).
# Used by scripts/run_stage1.sh and python -m tools.rfdetr_train.*

# Required for CRRI (and other Roboflow Universe) downloads
ROBOFLOW_API_KEY=

# Optional — BharatPotHole / Kaggle extras
KAGGLE_USERNAME=
KAGGLE_KEY=

# Optional — Google Maps JS API key (embedded into dashboard HTML at generate time)
# Restrict the key by HTTP referrer in Google Cloud Console.
#   echo 'GOOGLE_MAPS_API_KEY=AIza...' >> .env
GOOGLE_MAPS_API_KEY=
